<Page x:Class="Ab4d.SharpEngine.Samples.Wpf.Advanced.OverlayControlsSample"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:sharpEngine="clr-namespace:Ab4d.SharpEngine.Wpf;assembly=Ab4d.SharpEngine.Wpf"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OverlayControlsSample">

    <Grid Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Vertical" Margin="10">
            <TextBlock Text="Render WPF controls as Sprites in Ab4d.SharpEngine" FontSize="20" FontWeight="Bold" Foreground="#444" />
            <TextBlock Text="This sample is using OverlayTexture for PresentationType. This means that no other WPF control can be rendered on top of the 3D scene. But by using RenderTargetBitmap, it is possible to render WPF control to a bitmap and show it as a Sprite. The WPF controls are still created and process mouse events so if the sprite is rendered on the same positions as WPF control, then user can click on the controls."
                       FontSize="14" Margin="0 5 0 0" TextWrapping="Wrap" />
        </StackPanel>

        <sharpEngine:SharpEngineSceneView x:Name="MainSceneView" Grid.Row="1" PresentationType="OverlayTexture" BackgroundColor="White" />

        <Border Name="WpfControlsBorder" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="Black" BorderThickness="2" Background="#AAFFFFFF" Margin="5"
                MouseMove="WpfControlsBorder_OnMouseMove">
            <StackPanel Orientation="Vertical" Margin="10 5 10 8" Width="150">
                <Button Name="AddBoxButton" Content="Add box" Margin="0 2 0 2" Click="AddBoxButton_OnClick" />

                <CheckBox Name="UpdateOnMouseMoveCheckBox" Content="Update on mouse move" IsChecked="False" Margin="0 2 0 2"
                          ToolTip="When checked than the bitmap will be updated on mouse move. This can cause performance issues with frequent updates." />

                <TextBlock Name="InfoTextBlock" Text="Slider: 50" FontWeight="Bold" Margin="0 10 0 2" />
                <Slider Name="TestSlider" Minimum="0" Maximum="100" Value="50" Margin="0 2 0 2" ValueChanged="TestSlider_OnValueChanged"></Slider>
            </StackPanel>
        </Border>
    </Grid>
</Page>
